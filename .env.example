# ============================================================
# Copilot Teams Bridge — Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- REQUIRED ---

# Teams Workflows webhook URL (from Power Automate)
# Get this by creating a "Post to a channel when a webhook request is received"
# workflow in your Teams channel. See docs/power-automate-setup.md.
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...

# Path to the OneDrive-synced folder where Power Automate drops message files.
# Windows example:  C:\Users\you\OneDrive - Your Org\CopilotCommands
# WSL example:      /mnt/c/Users/you/OneDrive - Your Org/CopilotCommands
TEAMS_COMMANDS_DIR=/mnt/c/Users/you/OneDrive - Your Org/CopilotCommands

# --- SECURITY ---

# Comma-separated list of allowed senders (case-insensitive substring match).
# Messages from senders not matching any entry are silently ignored.
# Example: "Tam, Victor,Smith, Jane"
ALLOWED_SENDERS=

# --- COPILOT CLI ---

# Working directory for Copilot CLI execution
COPILOT_WORK_DIR=~/my-project

# System prompt prepended to every Copilot CLI invocation.
# Customize this to set your assistant's identity and instructions.
COPILOT_SYSTEM_PROMPT=You are a helpful AI assistant. Process the following request fully.

# Copilot CLI model to use (default: claude-sonnet-4-20250514)
COPILOT_MODEL=claude-sonnet-4-20250514

# Execution timeout in seconds (default: 1800 = 30 minutes)
COPILOT_TIMEOUT=1800

# Enable full autopilot mode (--allow-all). WARNING: allows file edits,
# bash commands, and API calls without confirmation. Default: false.
COPILOT_ALLOW_ALL=false

# Maximum autopilot continuation steps (default: 30)
COPILOT_MAX_CONTINUES=30

# --- POLLING INTERVALS (seconds) ---

# How often to check for new Teams messages (default: 120)
TEAMS_POLL_INTERVAL=120

# How often to process the pending queue (default: 60)
QUEUE_POLL_INTERVAL=60

# How often to send heartbeat to Teams (default: 3600)
HEARTBEAT_INTERVAL=3600

# --- PATHS ---

# Directory for state files (queue, lock, health)
DATA_DIR=~/.config/copilot-teams-bridge

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
